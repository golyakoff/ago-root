<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="AGO Platform" id="id-model-ago" version="5.0.0">
  <folder name="Strategy" id="id-folder-strategy" type="strategy"/>
  <folder name="Business" id="id-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Visitor" id="id-visitor">
      <documentation>Shop's customer, talks through the widget or a channel.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Operator" id="id-operator">
      <documentation>Answers conversations and books appointments from the console.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Tenant" id="id-tenant">
      <documentation>Owns a site, configures it (widget appearance, offline auto-reply, calendar).</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Platform owner" id="id-platform-owner">
      <documentation>Runs every tenant on the platform; may also be a tenant of their own.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Get support via chat" id="id-svc-chat"/>
    <element xsi:type="archimate:BusinessService" name="Book an appointment" id="id-svc-booking"/>
  </folder>
  <folder name="Application" id="id-folder-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Widget" id="id-widget">
      <documentation>ago-widget - the embeddable script. Shadow DOM, no build step for the tenant.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Console" id="id-console">
      <documentation>ago-console - the operator SPA (React).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Chat.Api" id="id-chat-api">
      <documentation>ago-chat: SignalR hubs + REST, holds connections, signs upload URLs.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Chat.Worker" id="id-chat-worker">
      <documentation>ago-chat: outbox dispatcher, assignment engine, background consumers.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Chat.Webhooks" id="id-chat-webhooks">
      <documentation>ago-chat: bulkhead for outbound third-party calls (adr/0013).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AGO Inbox channel adapters" id="id-inbox">
      <documentation>Planned, Stage 14: MAX, SMS, Telegram - extends Chat, not a third product.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Calendar Console" id="id-cal-console">
      <documentation>ago-calendar-console - own repository (adr/0064).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Calendar.Api" id="id-cal-api">
      <documentation>ago-calendar: tenant embed surface, per-tenant CORS.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Calendar.Worker" id="id-cal-worker">
      <documentation>ago-calendar: confirmation sweep, pending-booking queue.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationCollaboration" name="Module contract (adr/0065)" id="id-module-contract">
      <documentation>Planned, Stage 21: moduleKey / task / step - AGO Chat carries Calendar's steps without understanding them.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Ago.Platform.Abstractions" id="id-platform-abstractions">
      <documentation>ago-platform: one port per external resource - Postgres, RabbitMQ, Redis, S3, Keycloak.</documentation>
    </element>
  </folder>
  <folder name="Technology" id="id-folder-tech" type="technology">
    <element xsi:type="archimate:Node" name="PostgreSQL" id="id-postgres">
      <documentation>Source of truth. Each product: its own database, never shared (adr/0027).</documentation>
    </element>
    <element xsi:type="archimate:Node" name="RabbitMQ" id="id-rabbitmq">
      <documentation>Outbox to broker. No two hosts call each other synchronously.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Redis" id="id-redis">
      <documentation>Cache, presence, connection registry, rate limits. Never a source of truth.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="S3 / MinIO" id="id-s3">
      <documentation>Attachments. Bytes never pass through the API - presigned URLs.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Keycloak" id="id-keycloak">
      <documentation>OIDC identity for both operators and visitors.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Prometheus / Jaeger" id="id-observability">
      <documentation>OpenTelemetry - metrics, traces, dashboards.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="k3s (1 node)" id="id-k3s">
      <documentation>ago-deploy - Kustomize overlays, one Kubernetes node.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="NGINX Gateway Fabric" id="id-gateway">
      <documentation>Public edge - TLS, least_conn, no sticky sessions.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-folder-motivation" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-folder-impl" type="implementation_migration"/>
  <folder name="Other" id="id-folder-other" type="other"/>
  <folder name="Relations" id="id-folder-rel" type="relations">
    <element xsi:type="archimate:TriggeringRelationship" id="id-r1" source="id-visitor" target="id-gateway"/>
    <element xsi:type="archimate:TriggeringRelationship" id="id-r2" source="id-operator" target="id-gateway"/>
    <element xsi:type="archimate:TriggeringRelationship" id="id-r3" source="id-tenant" target="id-gateway"/>
    <element xsi:type="archimate:TriggeringRelationship" id="id-r4" source="id-platform-owner" target="id-gateway"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r5" source="id-gateway" target="id-widget"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r6" source="id-gateway" target="id-console"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r7" source="id-gateway" target="id-cal-console"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r8" source="id-widget" target="id-chat-api"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r9" source="id-console" target="id-chat-worker"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r10" source="id-cal-console" target="id-cal-api"/>
    <element xsi:type="archimate:FlowRelationship" id="id-r11" source="id-chat-api" target="id-chat-worker"/>
    <element xsi:type="archimate:FlowRelationship" id="id-r12" source="id-chat-worker" target="id-chat-webhooks"/>
    <element xsi:type="archimate:FlowRelationship" id="id-r13" source="id-cal-api" target="id-cal-worker"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r14" source="id-chat-api" target="id-platform-abstractions"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r15" source="id-chat-worker" target="id-platform-abstractions"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r16" source="id-cal-api" target="id-platform-abstractions"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r17" source="id-cal-worker" target="id-platform-abstractions"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r18" source="id-platform-abstractions" target="id-postgres"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r19" source="id-platform-abstractions" target="id-rabbitmq"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r20" source="id-platform-abstractions" target="id-redis"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r21" source="id-platform-abstractions" target="id-s3"/>
    <element xsi:type="archimate:ServingRelationship" id="id-r22" source="id-platform-abstractions" target="id-keycloak"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-r23" source="id-chat-webhooks" target="id-module-contract">
      <documentation>Planned - Stage 21</documentation>
    </element>
    <element xsi:type="archimate:AssociationRelationship" id="id-r24" source="id-module-contract" target="id-cal-api">
      <documentation>Planned - Stage 21</documentation>
    </element>
    <element xsi:type="archimate:AssociationRelationship" id="id-r25" source="id-inbox" target="id-chat-api">
      <documentation>Planned - Stage 14</documentation>
    </element>
    <element xsi:type="archimate:RealizationRelationship" id="id-r26" source="id-widget" target="id-svc-chat"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-r27" source="id-cal-console" target="id-svc-booking"/>
  </folder>
